{
	"name": "@hyperupcall/commitlint-config",
	"version": "0.1.0",
	"type": "module",
	"license": "MPL-2.0",
	"private": false,
	"packageManager": "pnpm@12.21.0",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "12.21.0",
			"onFail": "download"
		}
	},
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"keywords": [
		"commitlint"
	],
	"scripts": {
		"format": "hyperupcall-scripts-nodejs format",
		"lint": "hyperupcall-scripts-nodejs lint"
	},
	"devDependencies": {
		"@hyperupcall/scripts-nodejs": "0.15.1"
	},
	"markdownlint-cli2": {
		"extends": "./node_modules/@hyperupcall/scripts-nodejs/.markdownlint.mjs"
	},
	"npmpackagejsonlint": {
		"extends": "@hyperupcall/scripts-nodejs/npmpackagejsonlint.config.js"
	},
	"prettier": "@hyperupcall/scripts-nodejs/config-prettier.js"
}
