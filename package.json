{
	"name": "@hyperupcall/commitlint-config",
	"version": "0.2.0",
	"type": "module",
	"repository": {
		"type": "git",
		"url": "https://github.com/hyperupcall-projects/commitlint-config"
	},
	"bugs": {
		"url": "https://github.com/hyperupcall-projects/commitlint-config/issues"
	},
	"author": "Edwin Kofler <edwin@kofler.dev> (https://edwinkofler.com)",
	"license": "MPL-2.0",
	"private": false,
	"packageManager": "pnpm@12.23.0",
	"exports": {
		"types": "./index.d.ts",
		"default": "./index.js"
	},
	"files": [
		"./index.d.ts",
		"./index.js"
	],
	"keywords": [
		"commitlint",
		"commitlint-config"
	],
	"scripts": {
		"format": "hyperupcall-scripts-nodejs format",
		"lint": "hyperupcall-scripts-nodejs lint"
	},
	"dependencies": {
		"@commitlint/types": "21.2.3"
	},
	"devDependencies": {
		"@hyperupcall/scripts-nodejs": "0.16.0"
	},
	"markdownlint-cli2": {
		"extends": "./node_modules/@hyperupcall/scripts-nodejs/.markdownlint.mjs"
	},
	"npmpackagejsonlint": {
		"extends": "@hyperupcall/scripts-nodejs/config-npmpackagejsonlint.js"
	},
	"prettier": "@hyperupcall/scripts-nodejs/config-prettier.js"
}
